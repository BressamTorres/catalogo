APP_NAME="Catálogo"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://CATALOG_DOMAIN
APP_TIMEZONE=America/Sao_Paulo

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=catalogo_db
DB_USERNAME=catalogo_user
DB_PASSWORD=

ERP_DB_HOST=mysql
ERP_DB_PORT=3306
ERP_DB_DATABASE=blog_infinit
ERP_DB_USERNAME=catalog_reader
ERP_DB_PASSWORD=

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_CONNECTION=default
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=catalog-redis
REDIS_PASSWORD=
REDIS_PORT=6379

MINI_ERP_API_URL=http://mini-erp-api
CATALOG_CREDENTIAL_KEY=
MINI_ERP_API_TIMEOUT=10
MINI_ERP_API_CONNECT_TIMEOUT=3
MINI_ERP_PUBLIC_STORAGE_URL=https://ERP_DOMAIN/storage
MINI_ERP_PRODUCTS_PUBLIC_URL=
